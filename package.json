{
  "name": "my-extensions",
  "private": true,
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": "24.16.0"
  },
  "volta": {
    "node": "24.16.0",
    "pnpm": "12.4.2"
  },
  "scripts": {
    "dev:all": "turbo run dev",
    "build:all": "turbo run build",
    "tg:dev": "pnpm --filter @my-extensions/tg-download dev",
    "tg:build": "pnpm --filter @my-extensions/tg-download build",
    "x:dev": "pnpm --filter @my-extensions/x-download dev",
    "x:build": "pnpm --filter @my-extensions/x-download build",
    "x-helper:build": "zsh apps/helpers/x-download-helper/scripts/build.sh",
    "x-helper:dev": "zsh apps/helpers/x-download-helper/scripts/run.sh",
    "tabs:dev": "pnpm --filter @my-extensions/my-tabs dev",
    "tabs:build": "pnpm --filter @my-extensions/my-tabs build"
  },
  "devDependencies": {
    "turbo": "2.10.12"
  }
}
