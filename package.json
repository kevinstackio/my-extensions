{
  "name": "omyexts",
  "private": true,
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": "24.16.0"
  },
  "volta": {
    "node": "24.16.0",
    "pnpm": "12.4.2"
  },
  "scripts": {
    "website:dev": "turbo run dev --filter=@omyexts/website",
    "omytabs:dev": "pnpm --filter @omyexts/omytabs dev",
    "omydl:dev": "pnpm --filter @omyexts/omydl dev",
    "x:dev": "pnpm --filter @omyexts/x-download dev",
    "x-helper:dev": "zsh apps/helpers/x-download-helper/scripts/run.sh"
  },
  "devDependencies": {
    "turbo": "2.10.12"
  }
}
